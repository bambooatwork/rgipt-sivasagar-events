rules_version = '2';

// =====================================================================
//  Firestore security rules — RGIPT Sivasagar Campus Event Portal
//
//  These are the rules the LIVE site depends on. Deploy them with:
//
//      firebase deploy --only firestore:rules
//
//  or paste the contents into
//  Firebase console -> Firestore Database -> Rules -> Publish.
//
//  The site is public and read-only for visitors:
//    * visitors may READ published events and announcements;
//    * visitors may CREATE a registration and a contact message;
//    * everything else — reading registrations, reading messages, and all
//      writes to events/announcements — requires a signed-in admin.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can read PUBLISHED events and announcements.
    // Only a signed-in admin can create, edit or delete them.
    //
    // NOTE: the public site always queries with `where isPublished == true`,
    // because Firestore evaluates `allow read` against the QUERY, not just
    // the document. A query that could return an unpublished doc is denied.
    match /events/{doc} {
      allow read:  if resource.data.isPublished == true || request.auth != null;
      allow write: if request.auth != null;
    }

    match /announcements/{doc} {
      allow read:  if resource.data.isPublished == true || request.auth != null;
      allow write: if request.auth != null;
    }

    // Anyone can register for an event (create only), with basic checks.
    // Only a signed-in admin can read, change or delete registrations.
    match /registrations/{doc} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 120
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('.*@.*')
                    && request.resource.data.eventId is string;
      allow read, update, delete: if request.auth != null;
    }

    // Contact form: anyone can send, only admins can read.
    match /messages/{doc} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 4000;
      allow read, update, delete: if request.auth != null;
    }
  }
}
